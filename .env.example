# Frontend Public Configuration (Browser-safe)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_API_URL=http://localhost:3001/api/v1

# Backend Server Configuration (Server-Only / Confidential)
PORT=3001
NODE_ENV=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
FRONTEND_ORIGIN=http://localhost:5173

# AI & Document Intelligence Provider (Server-Only)
# Options: gemini, openai, anthropic, or demo
AI_PROVIDER=demo
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# Limits & Safeguards
MAX_FILE_SIZE_MB=15
MAX_DOCUMENTS_PER_CASE=10
RATE_LIMIT_MAX_PER_MINUTE=60
RETENTION_DAYS_DEFAULT=90
