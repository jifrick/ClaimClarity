# ==============================================================================
# ClaimClarity Environment Configuration Template
# ==============================================================================

# 1. Frontend Public Configuration (Browser-Safe - Bundled into Client)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_API_URL=http://localhost:3001/api/v1

# 2. Backend Server Configuration (Confidential - Server-Only)
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# 3. Storage Architecture Adapter (Server-Only)
# Options: 'memory' (Local development / CI) or 'supabase' (Production PostgreSQL & Storage)
STORAGE_MODE=memory
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-confidential-service-role-key-here
# Optional Direct PostgreSQL Connection String (for CLI migrations / direct pools):
# postgresql://postgres.<project-id>:<percent-encoded-password>@<pooler-host>:5432/postgres

# 4. AI & Document Intelligence Provider (Server-Only)
# Options: 'demo' (Offline deterministic verifier), 'gemini', 'openai', or 'anthropic'
AI_PROVIDER=demo
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
AI_TIMEOUT_MS=30000

# 5. Optical Character Recognition (OCR) Provider (Server-Only)
# Options: 'none' (Default: digital PDF extraction), 'mock' (Testing), 'cloud_vision', or 'textract'
OCR_PROVIDER=none
OCR_API_KEY=your-cloud-vision-or-textract-key
OCR_TIMEOUT_MS=15000

# 6. Safety Limits & Safeguards
MAX_FILE_SIZE_MB=15
MAX_DOCUMENTS_PER_CASE=10
RATE_LIMIT_MAX_PER_MINUTE=120
RETENTION_DAYS_DEFAULT=90
